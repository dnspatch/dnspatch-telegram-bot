# Environment of compose.yaml. Copy to .env and fill in.

# Token of the bot, from @BotFather in Telegram.
TELEGRAM_TOKEN=

# Chats that receive the notifications and may use /status, comma separated.
# Leave it empty and any chat can send /subscribe to the bot to get the
# notifications: handy at first, but then anyone who finds the bot can do it.
# To restrict it, send /start to the bot, put the chat id it replies with here
# and run `docker compose up -d` again; /subscribe is then ignored.
TELEGRAM_CHAT_IDS=

# Password of the DNS provider account (see dnspatch.toml).
PASSWORD=change-me

# Versions of the images. The default is latest; pin a release in production.
# DNSPATCH_VERSION=0.4.1
# BOT_VERSION=0.1.0

# Event types that are sent to the chats, comma separated: status,
# provider_status, retriever_status, ip_change, cycle, lifecycle. Every event
# is kept for /status either way. The default is all but cycle: a cycle comes
# every interval of the instance, which is too much for a chat.
# EVENTS=status,ip_change

# Log level of the bot: DEBUG, INFO (default), WARNING or ERROR.
# LOG_LEVEL=DEBUG
