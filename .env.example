# Environment of compose.yaml. Copy to .env and fill in.

# Token of the bot, from @BotFather in Telegram.
TELEGRAM_TOKEN=

# Chats that receive the notifications and may use /status, comma separated.
# Leave it empty on the first run, send /start to the bot, and it replies with
# your chat id; put it here and run `docker compose up -d` again.
TELEGRAM_CHAT_IDS=

# Password of the DNS provider account (see the dnspatch config in compose.yaml).
PASSWORD=change-me

# Versions of the images. The default is latest; pin a release in production.
# DNSPATCH_VERSION=0.4.0
# BOT_VERSION=0.1.0

# Log level of the bot: DEBUG, INFO (default), WARNING or ERROR.
# LOG_LEVEL=DEBUG
